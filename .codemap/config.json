{
  "only": ["ts", "js", "json", "yml", "yaml", "md"],
  "exclude": ["node_modules", "dist", "coverage"],
  "depth": 4,
  "budgets": {},
  "routing": {
    "subsystems": [
      {
        "name": "contract",
        "paths": ["src/**/*.ts", "tests/**/*.ts", "docs/**/*.md"],
        "keywords": ["Plugin", "definePlugin", "validatePlugin", "AIHU_VERSION"],
        "docs": ["README.md", "docs/superpowers/specs/2026-05-02-spec-plugin-contract.md"],
        "note": "The public contract is coupled to generated declarations and consumer peer ranges; codemap cannot follow those package metadata and documentation strings as imports."
      }
    ]
  },
  "drift": {
    "require_docs_for": ["contract"]
  },
  "guidance": {}
}
